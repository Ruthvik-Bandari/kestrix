                ]
              }
            },
            {
              "id": "html.url.javascript_scheme",
              "name": "HtmlUrlJavascriptScheme",
              "shortDescription": {
                "text": "javascript: URL in href, src, action or formaction"
              },
              "fullDescription": {
                "text": "A javascript: URL runs inline script when used, so the page needs a Content-Security-Policy with 'unsafe-inline'. The no-op forms javascript:void(0), javascript:; and javascript:undefined are not reported."
              },
              "help": {
                "text": "Use a button with an event listener from a script file, or a real URL.",
                "markdown": "**Why:** A javascript: URL runs inline script when used, so the page needs a Content-Security-Policy with 'unsafe-inline'. The no-op forms javascript:void(0), javascript:; and javascript:undefined are not reported.\n\n**Fix:** Use a button with an event listener from a script file, or a real URL."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
                "level": "note"
