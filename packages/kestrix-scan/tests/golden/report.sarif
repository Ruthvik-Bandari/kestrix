                "precision": "medium",
                "tags": [
                  "security",
                  "CWE-319"
                ]
              }
            },
            {
              "id": "html.angular.inner_html",
              "name": "HtmlAngularInnerHtml",
              "shortDescription": {
                "text": "Angular [innerHTML] binding of a value that is not a literal"
              },
              "fullDescription": {
                "text": "Angular sanitizes [innerHTML] values, so the binding is safe unless the value was marked trusted with bypassSecurityTrustHtml. It is reported at low severity as a place to check where the value comes from, in .html templates and in inline template: strings of .ts files."
              },
              "help": {
                "text": "Bind plain text with Angular's interpolation or [textContent]. Keep [innerHTML] for values that Angular sanitizes, and sanitize with DOMPurify before any bypassSecurityTrustHtml call.",
                "markdown": "**Why:** Angular sanitizes [innerHTML] values, so the binding is safe unless the value was marked trusted with bypassSecurityTrustHtml. It is reported at low severity as a place to check where the value comes from, in .html templates and in inline template: strings of .ts files.\n\n**Fix:** Bind plain text with Angular's interpolation or [textContent]. Keep [innerHTML] for values that Angular sanitizes, and sanitize with DOMPurify before any bypassSecurityTrustHtml call."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "security-severity": "3.0",
                "precision": "low",
                "tags": [
                  "security",
                  "CWE-79"
                ]
              }
            },
            {
              "id": "css.import.http",
              "name": "CssImportHttp",
              "shortDescription": {
                "text": "CSS @import or url() over http:"
              },
              "fullDescription": {
                "text": "A stylesheet that imports another stylesheet or loads an asset over http: can be altered in transit, which lets an attacker restyle the page or load a tracking image. Loopback hosts are not reported."
