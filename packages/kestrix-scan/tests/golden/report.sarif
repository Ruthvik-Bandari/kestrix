            {
              "id": "css.expression.legacy",
              "name": "CssExpressionLegacy",
              "shortDescription": {
                "text": "CSS expression() (Internet Explorer 7 and older)"
              },
              "fullDescription": {
                "text": "expression() in a declaration runs JavaScript in Internet Explorer 7 and older. No supported browser does, so the finding marks legacy code or an injection gadget."
              },
              "help": {
                "text": "Remove the declaration and use CSS or a script instead.",
                "markdown": "**Why:** expression() in a declaration runs JavaScript in Internet Explorer 7 and older. No supported browser does, so the finding marks legacy code or an injection gadget.\n\n**Fix:** Remove the declaration and use CSS or a script instead."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
