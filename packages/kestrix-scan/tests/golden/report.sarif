            {
              "id": "config.claude.env_leak",
              "name": "ConfigClaudeEnvLeak",
              "shortDescription": {
                "text": "Credential written into the env block of Claude Code settings"
              },
              "fullDescription": {
                "text": "The env block of a settings file is passed to every session and its subprocesses, and a project settings file is usually committed, so a literal key there is shared with everyone who has the repository."
              },
              "help": {
                "text": "Remove the value from the settings file and export it in your shell or a secrets manager instead. Rotate the credential if it was ever committed.",
                "markdown": "**Why:** The env block of a settings file is passed to every session and its subprocesses, and a project settings file is usually committed, so a literal key there is shared with everyone who has the repository.\n\n**Fix:** Remove the value from the settings file and export it in your shell or a secrets manager instead. Rotate the credential if it was ever committed."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
