            {
              "id": "dep.vulnerable",
              "name": "DepVulnerable",
              "shortDescription": {
                "text": "Dependency version with a known vulnerability (OSV)"
              },
              "fullDescription": {
                "text": "A pinned dependency version is listed as affected in an OSV advisory. Whether your code reaches the vulnerable function is not analyzed, so treat it as exploitable until you know otherwise."
              },
              "help": {
                "text": "Upgrade the package to a fixed version and update the lockfile. If no fix exists, replace the package or record why it is safe in [tool.kestrix] ignore-advisories.",
                "markdown": "**Why:** A pinned dependency version is listed as affected in an OSV advisory. Whether your code reaches the vulnerable function is not analyzed, so treat it as exploitable until you know otherwise.\n\n**Fix:** Upgrade the package to a fixed version and update the lockfile. If no fix exists, replace the package or record why it is safe in [tool.kestrix] ignore-advisories."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
