                "precision": "medium",
                "tags": [
                  "security",
                  "CWE-79"
                ]
              }
            },
            {
              "id": "web.url.dynamic_scheme",
              "name": "WebUrlDynamicScheme",
              "shortDescription": {
                "text": "Link or frame URL bound to a value that is not a literal (javascript: URLs)"
              },
              "fullDescription": {
                "text": "A Vue :href / v-bind:href or a Svelte href={...} on an a, area, iframe, frame, embed, form or object element runs a javascript: URL when the value is one, and neither framework rewrites it. The finding is low when the value cannot be traced and medium when the expression reads the route or URL ($route.query, $page.url, searchParams). Values that start with a literal path, #, https://, mailto: or tel: are not reported."
              },
              "help": {
                "text": "Accept only http(s) and relative URLs: parse the value with new URL(value, location.origin) and check url.protocol is 'http:' or 'https:' before binding it, or build the link from a fixed origin and an encoded path.",
                "markdown": "**Why:** A Vue :href / v-bind:href or a Svelte href={...} on an a, area, iframe, frame, embed, form or object element runs a javascript: URL when the value is one, and neither framework rewrites it. The finding is low when the value cannot be traced and medium when the expression reads the route or URL ($route.query, $page.url, searchParams). Values that start with a literal path, #, https://, mailto: or tel: are not reported.\n\n**Fix:** Accept only http(s) and relative URLs: parse the value with new URL(value, location.origin) and check url.protocol is 'http:' or 'https:' before binding it, or build the link from a fixed origin and an encoded path."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "precision": "low",
                "tags": [
                  "security",
                  "CWE-79"
                ]
              }
            },
            {
              "id": "html.inline.event_handler",
              "name": "HtmlInlineEventHandler",
              "shortDescription": {
                "text": "Inline event handler attribute (onclick and the like)"
              },
              "fullDescription": {
                "text": "An attribute such as onclick or onload holds JavaScript, so the page needs a Content-Security-Policy with 'unsafe-inline' to work, which also lets injected markup run script."
              },
              "help": {
                "text": "Attach the handler from a script file with addEventListener and drop 'unsafe-inline' from script-src.",
                "markdown": "**Why:** An attribute such as onclick or onload holds JavaScript, so the page needs a Content-Security-Policy with 'unsafe-inline' to work, which also lets injected markup run script.\n\n**Fix:** Attach the handler from a script file with addEventListener and drop 'unsafe-inline' from script-src."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
