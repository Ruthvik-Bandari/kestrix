              }
            },
            {
              "id": "dep.malicious",
              "name": "DepMalicious",
              "shortDescription": {
                "text": "Dependency reported as a malicious package (OSV MAL-)"
              },
              "fullDescription": {
                "text": "The OpenSSF malicious-packages feed reports this package version as malware, typically code that steals credentials or opens a backdoor when it is installed or imported."
              },
              "help": {
                "text": "Remove the package and its lockfile entry, then rotate every credential, token and key on machines where it was installed.",
                "markdown": "**Why:** The OpenSSF malicious-packages feed reports this package version as malware, typically code that steals credentials or opens a backdoor when it is installed or imported.\n\n**Fix:** Remove the package and its lockfile entry, then rotate every credential, token and key on machines where it was installed."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
