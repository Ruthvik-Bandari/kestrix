                "precision": "medium",
                "tags": [
                  "security",
                  "CWE-1022"
                ]
              }
            },
            {
              "id": "html.form.http_action",
              "name": "HtmlFormHttpAction",
              "shortDescription": {
                "text": "Form that posts to an http: URL"
              },
              "fullDescription": {
                "text": "A form with action=\"http://...\" sends what the user typed (often a password or personal data) without encryption, where anyone on the network path can read or change it. Loopback hosts are not reported."
              },
              "help": {
                "text": "Post to an https:// URL, or to a relative path on an https site.",
                "markdown": "**Why:** A form with action=\"http://...\" sends what the user typed (often a password or personal data) without encryption, where anyone on the network path can read or change it. Loopback hosts are not reported.\n\n**Fix:** Post to an https:// URL, or to a relative path on an https site."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "security-severity": "5.5",
                "precision": "high",
                "tags": [
                  "security",
                  "CWE-319"
                ]
              }
            },
            {
              "id": "html.mixed.http_resource",
              "name": "HtmlMixedHttpResource",
              "shortDescription": {
                "text": "Script, stylesheet, frame or image loaded over http:"
              },
              "fullDescription": {
                "text": "A script, stylesheet, iframe or image with an http: URL can be altered in transit and is blocked or downgraded as mixed content on an https page. Loopback hosts are not reported."
              },
              "help": {
                "text": "Load the resource over https://, or host it yourself.",
                "markdown": "**Why:** A script, stylesheet, iframe or image with an http: URL can be altered in transit and is blocked or downgraded as mixed content on an https page. Loopback hosts are not reported.\n\n**Fix:** Load the resource over https://, or host it yourself."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
                "level": "note"
