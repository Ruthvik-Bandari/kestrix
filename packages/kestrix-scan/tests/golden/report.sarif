                  "CWE-693"
                ]
              }
            },
            {
              "id": "html.link.target_blank",
              "name": "HtmlLinkTargetBlank",
              "shortDescription": {
                "text": "target=\"_blank\" link to an external page without rel=\"noopener\""
              },
              "fullDescription": {
                "text": "Without noopener the opened page can read and redirect window.opener on browsers that do not imply it (all current browsers do for target=\"_blank\", older ones do not). Only absolute http(s) and protocol-relative links are reported; rel=\"noreferrer\" also counts as safe."
              },
              "help": {
                "text": "Add rel=\"noopener noreferrer\" to the link.",
                "markdown": "**Why:** Without noopener the opened page can read and redirect window.opener on browsers that do not imply it (all current browsers do for target=\"_blank\", older ones do not). Only absolute http(s) and protocol-relative links are reported; rel=\"noreferrer\" also counts as safe.\n\n**Fix:** Add rel=\"noopener noreferrer\" to the link."
              },
              "helpUri": "https://github.com/Ruthvik-Bandari/kestrix/blob/main/docs/modules/code.md#rules",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
