    given-names: Ruthvik
version: 0.1.0
date-released: "2026-10-14"
license: Apache-2.0
repository-code: "https://github.com/Ruthvik-Bandari/CTPPO-Cyber_Threat_Propagation_Path_Optimizer"
keywords:
  - security
  - sigma
  - detection-engineering
  - forensics
  - bitcoin
  - post-quantum
